{
  "@class" : "org.apereo.cas.support.saml.services.SamlRegisteredService",
  "serviceId" : "edatos-openmetadata",
  "name" : "edatos-openmetadata",
  "id" : 3,
  "evaluationOrder" : 10,
  "metadataLocation" : "classpath:/metadata/sp-openmetadata-metadata.xml",
  "attributeReleasePolicy" : {
    "@class" : "org.apereo.cas.services.ReturnMappedAttributeReleasePolicy",
     "authorizedToReleaseCredentialPassword" : false,
    "authorizedToReleaseProxyGrantingTicket" : false,
    "allowedAttributes" : {
      "@class" : "java.util.TreeMap",
      "username" : "groovy { return attributes['username'].get(0) }",
      "displayName" : "groovy { return attributes['name']?.get(0) }",
      "email" : "groovy { return attributes['mail']?.get(0) }"
    }
  },
  "accessStrategy" : {
    "@class" : "org.apereo.cas.services.DefaultRegisteredServiceAccessStrategy",
    "delegatedAuthenticationPolicy" : {
      "@class" : "org.apereo.cas.services.DefaultRegisteredServiceDelegatedAuthenticationPolicy",
      "allowedProviders" : [ "java.util.ArrayList", [ "DELEGATED_CAS", "SAML2EDatosSSOClient" ] ]
    },
    "enabled" : true,
    "ssoEnabled" : true
  },
  "properties" : {
    "@class" : "java.util.HashMap",
    "httpHeaderEnableStrictTransportSecurity" : {
      "@class" : "org.apereo.cas.services.DefaultRegisteredServiceProperty",
      "values" : [ "java.util.HashSet", [ "false" ] ]
    }
  }
}